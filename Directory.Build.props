<Project>
    <PropertyGroup Condition="'$(EnableRuntimeAsync)' == 'false'">
        <BaseIntermediateOutputPath>obj\compiler-async\</BaseIntermediateOutputPath>
        <BaseOutputPath>bin\compiler-async\</BaseOutputPath>
        <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
    </PropertyGroup>
</Project>
